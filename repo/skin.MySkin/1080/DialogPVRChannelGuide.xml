<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">11</defaultcontrol>
	<zorder>4</zorder>
	<controls>
		<control type="group">
			<animation effect="fade" start="0" end="100" time="100">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="100">WindowClose</animation>
			<animation effect="fade" start="100" end="75" time="0" condition="true">conditional</animation>
			<visible>!Window.IsActive(fullscreenvideo)</visible>
		</control>
		<control type="group">
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">conditional</animation>
			<control type="group">
				<include>OpenClose_Right</include>
				<control type="group">
					<include>R 1/3 Panel</include>
					<include content="box">
						<param name="texture" value="box3"/>
						<param name="bs" value="0,-30,-30,-20"/>
						<param name="cd" value="button_focus"/>
					</include>	
					<animation effect="fade" start="0" end="100" time="200">Focus</animation>
					<control type="image">
						<centerleft>50%</centerleft>
						<top>0</top>
						<bottom>75%</bottom>
						<aspectratio align="center" aligny="center">keep</aspectratio>
						<texture fallback="DefaultTVShows.png" >$INFO[Listitem.Icon]</texture>
					</control>
					<control type="textbox">
						<left>10</left>
						<top>25%</top>
						<width>600</width>
						<height>25%</height>
						<label>$INFO[ListItem.Plot]</label>
						<align>center</align>
						<aligny>center</aligny>								
						<autoscroll time="3000" delay="4000" repeat="5000">Skin.HasSetting(AutoScroll)</autoscroll>
					</control>
				</control>
				<control type="fixedlist" id="11">
					<right>5</right>
					<top>50%</top>
					<width>630</width>
					<height>48%</height>
					<bottom>0</bottom>
					<onup>11</onup>
					<ondown>11</ondown>
					<pagecontrol>60</pagecontrol>
					<scrolltime tween="cubic" easing="out">500</scrolltime>
					<movement>4</movement>
					<focusposition>4</focusposition>
					<itemlayout height="44" width="1900">
						<control type="label">
							<left>20</left>
							<width>150</width>
							<bottom>0</bottom>
							<aligny>center</aligny>
							<label>$INFO[ListItem.StartTime]</label>
						</control>
						<control type="label">
							<left>250</left>
							<width>360</width>
							<bottom>0</bottom>
							<align>right</align>
							<aligny>center</aligny>
							<label>$VAR[PVRListItemSubLabel]</label>
						</control>
					</itemlayout>
					<focusedlayout height="44" width="1900">
						<control type="image">
							<left>5</left>
							<top>-7</top>
							<width>620</width>
							<height>44</height>
							<texture colordiffuse="button_focus" border="16">boxes/box.png</texture>
						</control>
						<control type="label">
							<left>20</left>
							<width>150</width>
							<bottom>0</bottom>
							<aligny>center</aligny>
							<label>$INFO[ListItem.StartTime]</label>
							<textcolor>black</textcolor>
						</control>
						<control type="label">
							<left>250</left>
							<width>360</width>
							<bottom>0</bottom>
							<align>right</align>
							<aligny>center</aligny>
							<label>$VAR[PVRListItemSubLabelFocused]</label>
							<textcolor>black</textcolor>
							<scroll>true</scroll>
						</control>
					</focusedlayout>
				</control>
			</control>
		</control>
	</controls>
</window>
