<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>50</defaultcontrol>
	<views>50,640</views>
	<menucontrol>9000</menucontrol>
	<controls>
        <include>DefaultBG</include>
		<include>View_List</include>
		<include>GridLayout</include>
        <!--Addons -->
        <control type="group"> 
            <include>R 2/3 Panel</include>   
            <visible>Control.IsVisible(50) + Container.Content(addons) + Window.IsActive(addonbrowser)</visible>
        <!-- title -->
            <control type="label">
                <top>137</top>
                <left>48</left>
                <right>27</right>
                <font>Reg36</font>
                <align>left</align>
                <label>$INFO[ListItem.AddonName]</label>
            </control>
            <control type="image">
                <left>28</left>
                <top>200</top>
                <right>27</right>
                <height>285</height>
                <texture border="5">boxes/inner.png</texture>
            </control>                                     
        <!--Icon-->
            <control type="image">
                <right>27</right>
                <top>205</top>
                <width>275</width>
                <height>275</height>
                <aspectratio align="center" aligny="center" scalediffuse="true">keep</aspectratio>
                <texture background="true" diffuse="diffuse/panel2.png" fallback="DefaultVideo.png">$INFO[ListItem.Icon]</texture>
            </control>
            <control type="grouplist">
                <left>28</left>
                <top>207</top>
            <!--Addon Type-->                    
                <control type="button">
                    <width>800</width>
                    <height>60</height>
                    <align>left</align>
                    <textoffsetx>20</textoffsetx>
                    <textwidth>540</textwidth>
                    <texturenofocus>dialogs/default/separator.png</texturenofocus>
                    <label>$LOCALIZE[146]</label>
                    <label2>$INFO[ListItem.AddonType]</label2>
                    <visible>!String.IsEmpty(ListItem.AddonType)</visible>                         
                </control>
            <!--Version-->				
                <control type="button">
                    <width>800</width>
                    <height>60</height>
                    <align>left</align>
                    <textoffsetx>20</textoffsetx>
                    <textwidth>540</textwidth>
                    <texturenofocus>dialogs/default/separator.png</texturenofocus>
                    <label>$LOCALIZE[24051]</label>
                    <label2>$INFO[ListItem.AddonVersion]</label2>
                    <visible>!String.IsEmpty(ListItem.AddonVersion)</visible>  
                </control>
            <!--Author-->
                <control type="button"> 
                    <width>800</width>
                    <height>60</height>
                    <align>left</align>
                    <textoffsetx>20</textoffsetx>
                    <textwidth>540</textwidth>
                    <texturenofocus>dialogs/default/separator.png</texturenofocus>
                    <label>$LOCALIZE[21863]:</label>
                    <label2>$INFO[ListItem.AddonCreator]</label2>
                    <visible>!String.IsEmpty(ListItem.AddonCreator)</visible>    
                </control>
            <!--Status-->                    
                <control type="button">
                    <width>800</width>
                    <height>60</height>
                    <align>left</align>
                    <textoffsetx>20</textoffsetx>
                    <textwidth>540</textwidth>
                    <texturenofocus/>
                    <label>$LOCALIZE[126]:</label>
                    <label2>$INFO[ListItem.Property(Addon.Status)]</label2>
                    <visible>!String.IsEmpty(ListItem.Property(Addon.Status))</visible>                         
                </control>
            </control>
            <control type="textbox">
                <description>Plot value</description>
                <left>48</left>
                <top>487</top>
                <right>52</right>
                <height>580</height>
                <align>justify</align>
                <pagecontrol>60</pagecontrol>
                <label fallback="19055">[B]$INFO[ListItem.AddonSummary][/B][CR]$INFO[ListItem.AddonDescription]</label>
                <visible>String.IsEmpty(Window.Property(showinfo))</visible>
                <autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
            </control>
            <control type="textbox">
                <description>News value</description>
                <left>48</left>
                <top>487</top>
                <right>52</right>
                <height>400</height>
                <align>justify</align>
                <pagecontrol>61</pagecontrol>
                <label fallback="19055">$INFO[ListItem.AddonNews]</label>
                <visible>String.IsEqual(Window.Property(showinfo),news)</visible>
            </control>
        </control>
		<include>MediaMenuMouseOverlay</include>
		<control type="group">
			<include>MediaMenuCommon</include>
			<control type="grouplist" id="9000">
				<top>50</top>
				<include>MediaMenuListCommon</include>
				<control type="label" id="201">
					<include>MediaMenuLabelCommon</include>
					<label>$LOCALIZE[31021]</label>
				</control>
				<control type="radiobutton" id="7">
					<description>Hide foreign</description>
					<include>MediaMenuItemsCommon</include>
					<label>$LOCALIZE[25001]</label>
					<visible>Control.IsEnabled(7)</visible>
				</control>
				<control type="radiobutton" id="8">
					<description>Hide incompatible</description>
					<include>MediaMenuItemsCommon</include>
					<label>$LOCALIZE[24999]</label>
					<visible>Control.IsEnabled(8)</visible>
				</control>
				<control type="button" id="9">
					<description>Check for repository updates</description>
					<include>MediaMenuItemsCommon</include>
					<label>$LOCALIZE[24034]</label>
				</control>
				<control type="button" id="5">
					<description>Addon settings</description>
					<include>MediaMenuItemsCommon</include>
					<label>$LOCALIZE[10004]</label>
				</control>
                <include>MediaMenuNowPlaying</include>
			</control>
		</control>
        <!--  <include>Content</include>-->
	</controls>
</window>
