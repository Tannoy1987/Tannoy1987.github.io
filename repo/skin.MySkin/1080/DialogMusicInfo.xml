<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<controls> 
		<control type="image">
			<texture>colors/black.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<aspectratio aligny="top">scale</aspectratio>
			<texture colordiffuse="e01d1d1d" fallback="special://skin/extras/home-images/music.jpg">$INFO[ListItem.Art(fanart)]</texture>
		</control>
	<!--left-->
		<control type="group">
			<include>L 1/3 List</include>
		<!--CD-Image-->
			<control type="group">
				<visible>Container.Content(albums)</visible>
				    <top>10</top>
				    <left>10</left>
				    <right>10</right>
				    <bottom>10</bottom>				
				<control type="image">
				    <texture>$INFO[ListItem.Art(discart)]</texture>
				    <aspectratio>keep</aspectratio>
				    <animation effect="slide" start="0,0" end="0,-223" time="600" condition="true">WindowOpen</animation>
				    <animation effect="slide" start="0,-223"  end="0,0" time="300" condition="true">WindowClose</animation>
				</control>
				<control type="image">
				    <texture>$VAR[MusicInfoThumbVar]</texture>
				    <aspectratio>keep</aspectratio>
				    <animation effect="slide" start="0,0" end="0,223" time="600" condition="!String.IsEmpty(ListItem.Art(discart))">WindowOpen</animation>
				    <animation effect="slide" start="0,223"  end="0,0" time="300" condition="!String.IsEmpty(ListItem.Art(discart))">WindowClose</animation>
				</control>
			</control>
			<control type="group">
				<visible>Container.Content(artists)</visible>
				<visible>![String.IsEmpty(ListItem.Art(cutout)) | String.IsEmpty(ListItem.Art(clearlogo))]</visible>
				<control type="image">
				    <top>115</top>
				    <left>35</left>
				    <right>35</right>
				    <bottom>685</bottom>
				    <texture>$INFO[ListItem.Art(clearlogo)]</texture>
				    <aspectratio>keep</aspectratio>
				</control>
				<control type="image">
				    <top>400</top>
				    <left>-20</left>
				    <right>0</right>
				    <bottom>-25</bottom>
				    <texture fallback="$INFO[ListItem.Art(clearart)]">$INFO[ListItem.Art(cutout)]</texture>
				    <aspectratio>keep</aspectratio>
				</control>
			</control>
			<control type="group">
				<visible>Container.Content(songs)</visible>
				<control type="image">
					<right>10</right>
				    <texture>$INFO[ListItem.Art(fanart)]</texture>
				    <aspectratio>scale</aspectratio>
				</control>
			</control>
		</control>
		<control type="group">
			<visible>ControlGroup(9000).HasFocus()</visible>	
			<control type="image">
				<width>80</width>
				<height>80</height>
				<right>0</right>
				<centertop>50%</centertop>
				<texture>$VAR[Album/Tracklist]</texture>
			</control>
			<control type="image">
				<width>30</width>
				<height>50</height>
				<right>25</right>
				<top>460</top>
				<texture colordiffuse="button_focus">buttons/spinctrl/arrow-light-up.png</texture>
				<visible>Container.Content(artists) | Container.Content(albums)</visible>
			</control>
		</control>
		<control type="group">
			<animation effect="slide" end="0,1080" time="0" condition="[Container.Content(artists) | Container.Content(albums) | Container.Content(songs)] + !Control.HasFocus(50) + !Control.HasFocus(9334)">conditional</animation>
			<include>fullpanelright</include>
			<control type="button" id="9334">
				<visible>Container.Content(albums)</visible>
				<top>115</top>
				<right>17</right>
				<width>60</width>
				<height>60</height>
				<font>font16</font>
				<textcolor>button_focus</textcolor>
				<texturefocus colordiffuse="button_focus">osd/bingie/play_fo.png</texturefocus>
				<texturenofocus>osd/bingie/play_fo.png</texturenofocus>
				<onclick condition="System.HasAddon(script.playalbum)">RunScript(script.playalbum,albumid=$INFO[ListItem.DBID]&amp;tracknr=$INFO[Container(50).ListItem.TrackNumber])</onclick>
				<onclick condition="!System.HasAddon(script.playalbum)">Notification(Play Album script missing,Please install script.playalbum,5000)</onclick>
				<onleft>50</onleft>
				<ondown>50</ondown>
			</control>
			<control type="panel" id="50">
				<visible>![Container.Content(songs) | Container.Content(artists)]</visible>
				<left>-11</left>
				<top>192</top>
				<right>12</right>
				<bottom>55</bottom>
				<onback>9000</onback>
				<onright>9334</onright>
				<orientation>vertical</orientation>
				<itemlayout height="90" width="1265">
					<control type="group">
						<left>10</left>
    					<include content="bg">
    					    <param name="bs" value="5" />
    					</include>
						<control type="label">
							<left>20</left>
							<top>0</top>
							<right>20</right>
							<height>90</height>
							<font>font16</font>
							<align>left</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.TrackNumber]  -  $INFO[ListItem.Label]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="90" width="1265">
					<control type="group">
						<left>10</left>
						<include>focusbox</include>
						<control type="label">
							<left>20</left>
							<top>0</top>
							<right>20</right>
							<height>90</height>
							<font>font16</font>
							<align>left</align>
							<aligny>center</aligny>
							<textcolor>black</textcolor>
							<label>$INFO[ListItem.TrackNumber]  -  $INFO[ListItem.Label]</label>
						</control>
					</control>
				</focusedlayout>
			</control>
			<control type="panel" id="50">
				<visible>![Container.Content(songs) | Container.Content(albums)]</visible>
				<left>60</left>
				<top>2</top>
				<right>0</right>
				<bottom>5</bottom>
				<onback>9000</onback>
				<orientation>vertical</orientation>
				<itemlayout height="350" width="300">
					<control type="group">	
						<control type="image">
							<bordersize>10,-5,10,50</bordersize>
							<texture fallback="DefaultAudio.png" background="true">$INFO[ListItem.Thumb]</texture>
							<aspectratio>keep</aspectratio>
						</control>
						<control type="image">
							<bordersize>4,4,4,59</bordersize>
							<texture colordiffuse="border_alpha">boxes/borderinnerboxcircle2.png</texture>
						</control>
						<control type="textbox">
							<bottom>0</bottom>
							<height>60</height>
							<left>10</left>
							<right>10</right>
							<font>font10</font>
							<align>center</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label2,[COLOR button_focus], - [/COLOR]]$INFO[ListItem.Label]</label>
							<visible>Control.HasFocus(50)</visible>
						</control>
					</control>		
				</itemlayout>
				<focusedlayout height="350" width="300">
					<control type="group">
						<left>-2</left>
						<control type="image">
							<bordersize>10,-5,10,50</bordersize>
							<texture fallback="DefaultAudio.png" background="true">$INFO[ListItem.Thumb]</texture>
							<aspectratio>keep</aspectratio>
						</control>
						<control type="image">
							<bordersize>4,2,4,57</bordersize>
							<texture colordiffuse="button_focus">boxes/borderinnerboxcircle2.png</texture>
						</control>
						<control type="textbox">
							<bottom>0</bottom>
							<height>60</height>
							<left>10</left>
							<right>10</right>
							<font>font10</font>
							<align>center</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label2,[COLOR button_focus], - [/COLOR]]$INFO[ListItem.Label]</label>
							<autoscroll delay="1000" time="1000" repeat="1000">true</autoscroll>
						</control>
					</control>
				</focusedlayout>
			</control>
		</control>
		<include>MusicInfo</include>
		<include>crt</include>
		<!-- <include>Content</include> -->
	</controls>
</window>