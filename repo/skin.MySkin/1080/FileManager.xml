<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">20</defaultcontrol>
	<controls>
		<include content="DialogBackgroundCommons">
		   <param name="width" value="1920" />
		   <param name="height" value="1080" />
		   <param name="header_label" value="" />
		   <param name="header_id" value="1" />
	   </include>
		<control type="image">
			<description>Dialog Header image</description>
			<centerleft>50%</centerleft>
			<centerbottom>5%</centerbottom>
			<width>68</width>
			<height>68</height>
			<texture colordiffuse="button_focus" border="2">icons/file-manager/left-right.png</texture>
			<animation effect="fade" start="0" end="100" time="300" delay="100">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
		</control>
<!--left side-->
		<control type="group">
			<include>OpenClose_Left</include>
			<centerleft>100%</centerleft>
			<centertop>50%</centertop>
			<include content="FileManagerPanel">
				<param name="list_id" value="20" />
				<param name="scrollbar_id" value="60" />
				<param name="onleft_id" value="60" />
				<param name="onright_id" value="21" />
			</include>
			<control type="scrollbar" id="60">
				<top>115</top>
				<left>0</left>
				<width>12</width>
				<bottom>115</bottom>
				<onleft>20</onleft>
				<onright>20</onright>
				<orientation>vertical</orientation>
				<texturesliderbackground />
			</control>
		</control>
<!--right side-->
	<control type="group">
		<width>100%</width>
		<centerleft>100%</centerleft>
		<centertop>50%</centertop>
		<include>OpenClose_Right</include>
		<include content="FileManagerPanel">
			<param name="list_id" value="21" />
			<param name="scrollbar_id" value="61" />
			<param name="onleft_id" value="20" />
			<param name="onright_id" value="61" />
		</include>
		<control type="scrollbar" id="61">
			<left>950</left>
			<top>115</top>
			<width>12</width>
			<bottom>115</bottom>
			<onleft>21</onleft>
			<onright>21</onright>
			<texturesliderbackground />
			<orientation>vertical</orientation>
		</control>
	</control>
	<control type="group">
		<bottom>4%</bottom>
		<height>65</height>
		<animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
		<animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
		<control type="label">
			<right>110</right>
			<width>730</width>
			<height>48</height>
			<aligny>center</aligny>
			<align>center</align>
			<shadowcolor>text_shadow</shadowcolor>
			<label>$INFO[Container(21).CurrentItem,, / ]$INFO[Container(21).NumItems]</label>
		</control>
		<control type="label">
			<left>110</left>
			<width>730</width>
			<height>48</height>
			<aligny>center</aligny>
			<align>center</align>
			<shadowcolor>text_shadow</shadowcolor>
			<label>$INFO[Container(20).CurrentItem,, / ]$INFO[Container(20).NumItems]</label>
		</control>
		</control>
		<control type="group">
			<bottom>-15</bottom>
			<height>65</height>
			<animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
			<control type="label" id="102">
				<right>110</right>
				<width>730</width>
				<height>48</height>
				<font>font30_title</font>
				<align>center</align>
				<aligny>center</aligny>
				<label>$PARAM[header_label]</label>
				<haspath>true</haspath>
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="label" id="101">
				<left>110</left>
				<width>730</width>
				<height>48</height>
				<font>font30_title</font>
				<align>center</align>
				<aligny>center</aligny>
				<label>$PARAM[header_label]</label>
				<haspath>true</haspath>
				<shadowcolor>black</shadowcolor>
			</control>
		</control>
	</controls>
</window>
