<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>3</defaultcontrol>
	<controls>
		<include>DefaultBGNSB</include>
 		<include content="DialogBackgroundCommons">
			<param name="width" value="1920" />
			<param name="height" value="1080" />
			<param name="header_label" value="" />
			<param name="header_id" value="1" />
		</include>
		<control type="image">
			<description>separator image</description>
			<bottom>110</bottom>
			<left>10</left>
			<right>10</right>
			<height>3</height>
			<texture colordiffuse="AAAAAAAA" border="3">dialogs/separator-grey.png</texture>
		</control>	
		<control type="multiimage">
			<depth>DepthBackground</depth>
			<include>FullScreen</include>
			<aspectratio>scale</aspectratio>
			<animation effect="zoom" center="auto" end="102,102" time="0" condition="Integer.IsGreater(System.StereoscopicMode,0)">conditional</animation>
			<animation effect="fade" start="0" end="100" time="400" reversible="true" condition="!Window.Previous(Settings)">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="300" reversible="true" condition="!Window.Next(Settings)">WindowClose</animation>
			<animation effect="fade" time="400">VisibleChange</animation>
		</control>
		<control type="group">
			<include>OpenClose_Right</include>
			<!--Right-Side-->
			<control type="grouplist" id="5">
				<description>control area</description>
				<top>10%</top>
				<left>507</left>
				<right>5%</right>
				<pagecontrol>531</pagecontrol>
				<right>0</right>
				<onleft>3</onleft>
				<onright>531</onright>
				<onup>5</onup>
				<ondown>5</ondown>
				<itemgap>10</itemgap>
				<height>77.75%</height>
			</control>
		</control>
		<control type="button" id="7">
		</control>
		<control type="radiobutton" id="8">
		</control>
		<control type="spincontrolex" id="9">
		</control>
		<control type="sliderex" id="13">
		</control>
		<control type="label" id="14">
			<description>Default Label</description>
			<left>-20%</left>
			<width>1450</width>
			<textoffsetx>45</textoffsetx>
			<top>0</top>
			<height>60</height>
			<label></label>
			<align>center</align>
			<aligny>center</aligny>
			
			<textcolor>grey</textcolor>
			<shadowcolor>black</shadowcolor>
		</control>
		<control type="colorbutton" id="15">
			<description>Default ColorButton</description>
		</control>
		<control type="group">
			<depth>DepthContentPanel</depth>
			<include>OpenClose_Left</include>
			<!--Left-Side-->
			<control type="grouplist" id="3">
				<description>button area</description>
				<left>5%</left>
				<top>108</top>
				<width>23%</width>
				<height>810</height>
				<usecontrolcoords>true</usecontrolcoords>
				<onleft>SettingsLevelChange</onleft>
				<onright>5</onright>
				<onup>3</onup>
				<ondown>3</ondown>
				<itemgap>10</itemgap>
			</control>
			<control type="button" id="10">
				<description>Default Category Button</description>
				<width>400</width>
				<textoffsetx>0</textoffsetx>
				<aligny>center</aligny>
				<align>center</align>
				<font>Reg33</font>
			</control>
		</control>

		<include>BottomBar</include>
		<control type="group">
			<depth>DepthContentPanel</depth>
			<include>OpenClose_Left</include>
			<control type="radiobutton" id="20">
				<width>400</width>
				<left>5%</left>
				<bottom>142</bottom>
				<aligny>center</aligny>
				<onclick>SettingsLevelChange</onclick>
				<textoffsetx>100</textoffsetx>
				<textoffsety>0</textoffsety>
				<radioposx>40</radioposx>
				<radioposy>0</radioposy>
				<radiowidth>40</radiowidth>
				<radioheight>40</radioheight>
				<onleft>5</onleft>
				<onright>5</onright>
				<onup>3</onup>
				<ondown>3</ondown>
				<textureradioonfocus colordiffuse="black">icons/settings.png</textureradioonfocus>
				<textureradioonnofocus>icons/settings.png</textureradioonnofocus>
				<textureradioofffocus colordiffuse="black">icons/settings.png</textureradioofffocus>
				<textureradiooffnofocus>icons/settings.png</textureradiooffnofocus>
			</control>
			<control type="image">
				<width>30</width>
				<height>50</height>
				<left>100</left>
				<top>882</top>
				<texture>buttons/spinctrl/arrow-light-left.png</texture>
			</control>
			<control type="image">
				<width>30</width>
				<height>50</height>
				<left>100</left>
				<top>882</top>
				<texture colordiffuse="black">buttons/spinctrl/arrow-light-left.png</texture>
				<visible>Control.HasFocus(20)</visible>
			</control>
		</control>
		<control type="group">
			<include>OpenClose_Right</include>
			<control type="textbox" id="6">
				<description>description area</description>
				<left>8%</left>
				<bottom>5</bottom>
				<right>8%</right>
				<height>104</height>
				<font>Reg26</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>button_focus</textcolor>
				<autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
			</control>
		</control>
		<control type="label" id="2">
			<description>breadcrumbs label</description>
			<visible>false</visible>
		</control>
			<control type="scrollbar" id="531">
				<texturesliderbar colordiffuse="ff515151">colors/white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="button_focus">colors/white.png</texturesliderbarfocus>
				<onleft>5</onleft>
				<top>0</top>
                <right>0</right>
                <bottom>0</bottom>
				<width>3</width>
			</control>
		<include>crt</include>
	</controls>
</window>
