     	<include name="PicsInfoLine">
		<control type="grouplist">
			<visible>!String.IsEmpty($PARAM[value])</visible>
			<height>45</height>
			<orientation>horizontal</orientation>
	
			<itemgap>10</itemgap>
			<control type="label">
				<width>auto</width>
				<height>40</height>
				<aligny>center</aligny>
				<label>$PARAM[label]:</label>
				<textcolor>button_focus</textcolor>
			</control>
			<control type="label">
				<width>auto</width>
				<height>40</height>
				<align>right</align>
				<aligny>center</aligny>
				<label>$INFO[$PARAM[value]]</label>
			</control>
		</control>
	</include>
    	<include name="ShiftImageBox">
            
		<control type="image">
			<bordersize>10</bordersize>
			<aspectratio aligny="center">stretch</aspectratio>
			<texture>dialogs/dialog-bg-nobo.png</texture>
			<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
		</control>
		<control type="image">

			
			<aspectratio align="center" aligny="center">keep</aspectratio>
			<texture fallback="DefaultVideo.png" background="true">$VAR[ShiftThumbVar]</texture>
	
			<bordersize>10,10,10,120</bordersize>
			<visible>String.IsEmpty(ListItem.Art(poster))</visible>
		</control>
		<control type="image">
			<depth>DepthContentPopout</depth>

			<aspectratio aligny="center">scale</aspectratio>
			<texture fallback="DefaultVideo.png" background="true">$VAR[ShiftThumbVar]</texture>

			<bordersize>10,10,10,120</bordersize>
			<visible>!String.IsEmpty(ListItem.Art(poster))</visible>
		</control>
		<control type="textbox">
			<left>20</left>
			<bottom>10</bottom>
			<right>20</right>
			<top>360</top>
			<align>center</align>
			<aligny>center</aligny>
			<label>$INFO[ListItem.Label]</label>
            
		</control>
		<include>IconStatusOverlay</include>
		<control type="group">
